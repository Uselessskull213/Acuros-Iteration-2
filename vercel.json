{
  "version": 2,
  "framework": "astro",
  "buildCommand": "astro build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/onboarding.js": { "maxDuration": 60 },
    "api/portal-edit.js": { "maxDuration": 60 },
    "api/chat.js": { "maxDuration": 60 }
  },
  "redirects": [
    { "source": "/developer", "has": [{ "type": "host", "value": "acuros.ca" }],     "destination": "https://dev.acuros.ca/", "permanent": false },
    { "source": "/developer", "has": [{ "type": "host", "value": "www.acuros.ca" }], "destination": "https://dev.acuros.ca/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "dev.acuros.ca" }], "destination": "/developer" },
    { "source": "/c/:slug",     "destination": "/api/clinic-page?slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",          "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",          "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection",         "value": "1; mode=block" },
        { "key": "Permissions-Policy",       "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
