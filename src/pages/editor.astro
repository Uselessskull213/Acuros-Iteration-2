<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<meta name="robots" content="noindex"/>
<title>Portal Editor · Acuros Health</title>
<link rel="icon" type="image/png" href="/favicon-32.png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<style is:inline>
:root{
  --bg:#0a0a09;--bg2:#111110;--bg3:#161614;--bg4:#1d1d1a;
  --border:#222220;--border-hi:#33332e;
  --text:#f0ede8;--sub:#9a948a;--mute:#5b574f;
  --ac:#4990d4;--ac-hi:#6fa8e0;
  --ok:#7fb47f;--warn:#d4a45a;--err:#c87a6e;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--text);font-size:14px;line-height:1.55}
button{font-family:inherit;cursor:pointer;border:0;background:none;color:inherit}
input,textarea{font-family:inherit;color:inherit;background:none;border:0;outline:0;resize:none}
a{color:var(--ac);text-decoration:none}
a:hover{color:var(--ac-hi)}

/* ── Top bar ─────────────────────────────────────────────── */
.topbar{position:fixed;top:0;left:0;right:0;height:54px;background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;padding:0 1.25rem;z-index:50}
.topbar-l{display:flex;align-items:center;gap:1rem}
.topbar-logo{font-family:'Cormorant Garamond',serif;font-size:1.1rem;letter-spacing:.18em;color:var(--text)}
.topbar-logo em{color:var(--ac);font-style:italic;font-weight:400}
.topbar-crumb{font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;color:var(--mute)}
.topbar-r{display:flex;align-items:center;gap:.5rem}
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.55rem 1rem;font-size:.65rem;letter-spacing:.16em;text-transform:uppercase;font-weight:500;border:1px solid var(--border-hi);background:transparent;color:var(--text);transition:background .2s,border-color .2s,color .2s}
.btn:hover{background:var(--bg4);border-color:#4a4842}
.btn-pri{background:var(--ac);border-color:var(--ac);color:#0a0a09}
.btn-pri:hover{background:var(--ac-hi);border-color:var(--ac-hi);color:#0a0a09}
.btn-ghost{border-color:transparent;color:var(--sub)}
.btn-ghost:hover{color:var(--text);background:var(--bg4)}
.btn[disabled]{opacity:.4;cursor:not-allowed}
.status-pill{display:inline-flex;align-items:center;gap:.45rem;padding:.35rem .7rem;font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;color:var(--sub);background:var(--bg3);border:1px solid var(--border)}
.status-pill .dot{width:6px;height:6px;border-radius:50%;background:var(--mute)}
.status-pill.live .dot{background:var(--ok);box-shadow:0 0 8px rgba(127,180,127,.5)}
.status-pill.draft .dot{background:var(--warn)}
.status-pill.saving .dot{background:var(--ac);animation:pulse 1s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.4}50%{opacity:1}}

/* ── Layout ──────────────────────────────────────────────── */
.app{position:fixed;top:54px;left:0;right:0;bottom:0;display:grid;grid-template-columns:1fr 420px;gap:1px;background:var(--border)}
@media(max-width:980px){.app{grid-template-columns:1fr;grid-template-rows:1fr 50vh}}

/* ── Preview ────────────────────────────────────────────── */
.preview{background:var(--bg);display:flex;flex-direction:column;position:relative}
.preview-bar{height:38px;display:flex;align-items:center;justify-content:space-between;padding:0 1rem;background:var(--bg2);border-bottom:1px solid var(--border)}
.preview-tabs{display:flex;gap:.25rem}
.preview-tab{padding:.3rem .65rem;font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--sub);border-radius:0;background:transparent}
.preview-tab.active{color:var(--text);background:var(--bg3)}
.preview-tab:hover:not(.active){color:var(--text)}
.preview-actions{display:flex;align-items:center;gap:.5rem;font-size:.6rem;letter-spacing:.14em;text-transform:uppercase;color:var(--mute)}
.preview-actions button{padding:.3rem .55rem;color:var(--sub);font-size:.6rem;letter-spacing:.14em;text-transform:uppercase}
.preview-actions button:hover{color:var(--text)}
.preview-stage{flex:1;position:relative;background:radial-gradient(circle at 50% 30%,#181815 0%,#0a0a09 70%);display:flex;align-items:center;justify-content:center;padding:1.5rem;overflow:auto}
.viewport{background:#fff;box-shadow:0 30px 80px rgba(0,0,0,.45),0 0 0 1px rgba(255,255,255,.04);transition:width .25s ease,max-width .25s ease;width:100%;max-width:1280px;height:100%;display:flex;flex-direction:column}
.viewport.mobile{max-width:390px}
.viewport.tablet{max-width:820px}
.viewport iframe{flex:1;border:0;width:100%;background:#fff}
.viewport.code{padding:0;background:#0d0d0c}
.viewport.code pre{flex:1;margin:0;padding:1.5rem;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:.72rem;line-height:1.65;color:#cfcab9;background:#0d0d0c;overflow:auto;white-space:pre-wrap;word-break:break-word}
.empty-stage{text-align:center;color:var(--mute);max-width:32ch;padding:3rem 2rem}
.empty-stage h2{font-family:'Cormorant Garamond',serif;font-size:1.6rem;font-weight:300;color:var(--sub);margin-bottom:.65rem;letter-spacing:-.02em}
.empty-stage p{font-size:.78rem;line-height:1.65}

/* ── Chat sidebar ───────────────────────────────────────── */
.chat{background:var(--bg2);display:flex;flex-direction:column;min-width:0}
.chat-head{padding:1rem 1.25rem .85rem;border-bottom:1px solid var(--border)}
.chat-head h3{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:1.15rem;letter-spacing:-.01em;color:var(--text);display:flex;align-items:center;gap:.55rem}
.chat-head h3 em{color:var(--ac);font-style:italic}
.chat-head p{font-size:.68rem;color:var(--mute);margin-top:.3rem;letter-spacing:.04em}
.chat-log{flex:1;overflow:auto;padding:1.1rem 1.25rem;display:flex;flex-direction:column;gap:.9rem;scroll-behavior:smooth}
.msg{display:flex;flex-direction:column;gap:.25rem;max-width:100%}
.msg-meta{font-size:.55rem;letter-spacing:.22em;text-transform:uppercase;color:var(--mute)}
.msg-body{font-size:.82rem;line-height:1.55;padding:.7rem .85rem;border-radius:2px}
.msg.user .msg-body{background:var(--bg4);color:var(--text);align-self:flex-end;max-width:88%}
.msg.user .msg-meta{align-self:flex-end;color:var(--ac)}
.msg.ai .msg-body{background:var(--bg3);color:var(--sub);border-left:2px solid var(--ac)}
.msg.system .msg-body{background:transparent;color:var(--mute);font-style:italic;border:1px dashed var(--border-hi);font-size:.74rem}
.msg.err .msg-body{background:rgba(200,122,110,.08);color:var(--err);border-left:2px solid var(--err)}
.msg-time{font-size:.5rem;letter-spacing:.16em;text-transform:uppercase;color:var(--mute);margin-top:.25rem}
.typing{display:inline-flex;gap:3px;align-items:center}
.typing span{width:5px;height:5px;border-radius:50%;background:var(--ac);animation:typing 1.1s ease-in-out infinite}
.typing span:nth-child(2){animation-delay:.18s}
.typing span:nth-child(3){animation-delay:.36s}
@keyframes typing{0%,60%,100%{opacity:.25;transform:translateY(0)}30%{opacity:1;transform:translateY(-2px)}}

.chip-row{display:flex;gap:.4rem;flex-wrap:wrap;padding:.5rem 1.25rem 0}
.chip{font-size:.62rem;letter-spacing:.06em;padding:.4rem .65rem;background:var(--bg3);border:1px solid var(--border);color:var(--sub);transition:background .2s,color .2s,border-color .2s}
.chip:hover{background:var(--bg4);color:var(--text);border-color:var(--border-hi)}

.chat-input{padding:.85rem 1.25rem 1.1rem;border-top:1px solid var(--border);background:var(--bg2)}
.chat-input-wrap{position:relative;background:var(--bg3);border:1px solid var(--border);transition:border-color .2s}
.chat-input-wrap:focus-within{border-color:var(--border-hi)}
.chat-input textarea{display:block;width:100%;padding:.8rem 3rem .8rem .9rem;font-size:.85rem;line-height:1.5;background:transparent;color:var(--text);min-height:46px;max-height:200px}
.chat-input textarea::placeholder{color:var(--mute)}
.chat-send{position:absolute;right:8px;bottom:7px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;background:var(--ac);color:#0a0a09;border-radius:0;transition:background .2s,transform .1s}
.chat-send:hover:not([disabled]){background:var(--ac-hi)}
.chat-send:active:not([disabled]){transform:scale(.95)}
.chat-send[disabled]{background:var(--bg4);color:var(--mute)}
.chat-hint{font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);margin-top:.5rem;display:flex;justify-content:space-between;align-items:center}

/* ── Publish modal ──────────────────────────────────────── */
.modal{position:fixed;inset:0;background:rgba(8,8,7,.78);backdrop-filter:blur(8px);display:flex;align-items:center;justify-content:center;z-index:100;padding:1.5rem}
.modal[hidden]{display:none}
.modal-card{background:var(--bg2);border:1px solid var(--border-hi);max-width:440px;width:100%;padding:1.75rem}
.modal-card h2{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:1.6rem;letter-spacing:-.02em;margin-bottom:.4rem}
.modal-card p{font-size:.78rem;color:var(--sub);line-height:1.6;margin-bottom:1.25rem}
.modal-field{display:flex;flex-direction:column;gap:.35rem;margin-bottom:1rem}
.modal-field label{font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--mute)}
.modal-field input{background:var(--bg3);border:1px solid var(--border);padding:.65rem .8rem;font-size:.9rem;color:var(--text);transition:border-color .2s}
.modal-field input:focus{border-color:var(--ac)}
.modal-field .hint{font-size:.65rem;color:var(--mute)}
.modal-actions{display:flex;gap:.5rem;justify-content:flex-end;margin-top:1.5rem}

/* Loading overlay for full-stage operations */
.fullload{position:absolute;inset:0;background:rgba(10,10,9,.85);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;z-index:5;backdrop-filter:blur(4px)}
.fullload[hidden]{display:none}
.fullload .spinner{width:32px;height:32px;border:2px solid var(--bg4);border-top-color:var(--ac);border-radius:50%;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.fullload p{color:var(--sub);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase}

/* Scrollbars */
.chat-log::-webkit-scrollbar,.preview-stage::-webkit-scrollbar,.viewport.code pre::-webkit-scrollbar{width:6px;height:6px}
.chat-log::-webkit-scrollbar-thumb,.preview-stage::-webkit-scrollbar-thumb,.viewport.code pre::-webkit-scrollbar-thumb{background:var(--border-hi);border-radius:3px}

/* Gate (logged out / wrong role) */
.gate{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:var(--bg);z-index:200;padding:2rem;text-align:center}
.gate-card{max-width:36ch}
.gate-card h1{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:2.4rem;letter-spacing:-.025em;margin-bottom:1rem}
.gate-card h1 em{color:var(--ac);font-style:italic}
.gate-card p{color:var(--sub);line-height:1.7;margin-bottom:1.5rem;font-size:.88rem}
.gate-card .btn{padding:.75rem 1.4rem;font-size:.65rem}
</style>
</head>
<body>

<!-- Loading / gate (shown until we know auth state) -->
<div class="gate" id="gate" hidden>
  <div class="gate-card">
    <h1 id="gateTitle">Sign in to <em>edit</em></h1>
    <p id="gateMsg">Portal editing is for clinic owners. Sign in to continue.</p>
    <a class="btn btn-pri" id="gateCta" href="/patient-portal?role=owner">Sign in</a>
  </div>
</div>

<header class="topbar" id="topbar" hidden>
  <div class="topbar-l">
    <span class="topbar-logo">Acuros <em>Editor</em></span>
    <span class="topbar-crumb" id="clinicCrumb">Loading…</span>
  </div>
  <div class="topbar-r">
    <span class="status-pill" id="status"><span class="dot"></span><span id="statusLabel">Loading</span></span>
    <a class="btn btn-ghost" href="/developer" title="Developer console">Console</a>
    <button class="btn btn-ghost" id="viewLiveBtn" title="Open public portal" disabled>View live</button>
    <button class="btn" id="saveDraftBtn" disabled>Save draft</button>
    <button class="btn btn-pri" id="publishBtn" disabled>Publish</button>
  </div>
</header>

<main class="app" id="app" hidden>
  <section class="preview">
    <div class="preview-bar">
      <div class="preview-tabs">
        <button class="preview-tab active" data-tab="preview">Preview</button>
        <button class="preview-tab" data-tab="code">HTML</button>
      </div>
      <div class="preview-actions">
        <button data-vp="desktop" class="active">Desktop</button>
        <button data-vp="tablet">Tablet</button>
        <button data-vp="mobile">Mobile</button>
      </div>
    </div>
    <div class="preview-stage" id="stage">
      <div class="viewport" id="viewport">
        <iframe id="previewFrame" sandbox="allow-scripts allow-same-origin" referrerpolicy="no-referrer"></iframe>
      </div>
      <div class="fullload" id="fullload" hidden>
        <div class="spinner"></div>
        <p id="fullloadLabel">Generating…</p>
      </div>
    </div>
  </section>

  <aside class="chat">
    <div class="chat-head">
      <h3>AI <em>Sidebar</em></h3>
      <p>Describe a change. The AI rewrites your portal, and the preview updates instantly.</p>
    </div>
    <div class="chat-log" id="chatLog"></div>
    <div class="chip-row" id="chipRow"></div>
    <div class="chat-input">
      <div class="chat-input-wrap">
        <textarea id="chatInput" placeholder="e.g. add a doctor bios section under the hero…" rows="2"></textarea>
        <button class="chat-send" id="chatSend" title="Send (⌘↵)" disabled>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
      <div class="chat-hint">
        <span>⌘↵ to send</span>
        <span id="modelInfo">Claude · Sonnet 4.5</span>
      </div>
    </div>
  </aside>
</main>

<!-- Publish modal -->
<div class="modal" id="publishModal" hidden>
  <div class="modal-card">
    <h2>Publish portal</h2>
    <p>Your draft will go live at <strong style="color:var(--ac)" id="liveUrlPreview">acuros.ca/c/…</strong>. SEO + meta tags auto-update.</p>
    <div class="modal-field">
      <label for="slugInput">Portal URL slug</label>
      <input type="text" id="slugInput" placeholder="aaa-clinics" maxlength="32"/>
      <span class="hint">Lowercase letters, numbers, and hyphens. 3–32 chars.</span>
    </div>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="publishCancel">Cancel</button>
      <button class="btn btn-pri" id="publishConfirm">Publish now</button>
    </div>
  </div>
</div>

<script is:inline>
(() => {
  const SB_URL = 'https://pyexkdoupqzbnrybiubo.supabase.co';
  // Use the legacy JWT anon key so this page shares the same localStorage
  // namespace as patient.html / dashboard.html / settings.html. The
  // publishable-key client writes to a different namespace and would make
  // signed-in users appear signed-out when they navigate to /editor.
  const SB_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InB5ZXhrZG91cHF6Ym5yeWJpdWJvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE4Mzg4MzYsImV4cCI6MjA4NzQxNDgzNn0.3_dLQEJfmC08A2-hlgOfwlu4ngx7hslUR3Dun4BoXLU';
  const sb = window.supabase.createClient(SB_URL, SB_KEY);

  const DRAFT_KEY = 'acuros-portal-draft';
  const HISTORY_KEY = 'acuros-portal-history';

  // ── State ──────────────────────────────────────────────
  const state = {
    user: null,
    org: null,                // organizations row
    services: [],
    products: [],
    html: '',                 // current HTML in editor
    publishedHtml: '',        // last-known persisted HTML (for dirty check)
    history: [],              // [{role, content, time}]
    busy: false,
    tab: 'preview',
    viewport: 'desktop',
    dirty: false,
  };

  // ── DOM refs ───────────────────────────────────────────
  const el = (id) => document.getElementById(id);
  const $ = {
    gate: el('gate'), gateTitle: el('gateTitle'), gateMsg: el('gateMsg'), gateCta: el('gateCta'),
    topbar: el('topbar'), app: el('app'),
    crumb: el('clinicCrumb'),
    status: el('status'), statusLabel: el('statusLabel'),
    viewLive: el('viewLiveBtn'), saveDraft: el('saveDraftBtn'), publishBtn: el('publishBtn'),
    stage: el('stage'), viewport: el('viewport'), iframe: el('previewFrame'),
    fullload: el('fullload'), fullloadLabel: el('fullloadLabel'),
    chatLog: el('chatLog'), chipRow: el('chipRow'),
    chatInput: el('chatInput'), chatSend: el('chatSend'), modelInfo: el('modelInfo'),
    publishModal: el('publishModal'), slugInput: el('slugInput'),
    publishCancel: el('publishCancel'), publishConfirm: el('publishConfirm'),
    liveUrlPreview: el('liveUrlPreview'),
  };

  // ── Helpers ────────────────────────────────────────────
  function escapeHtml(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function timeStr(){const d=new Date();return d.getHours().toString().padStart(2,'0')+':'+d.getMinutes().toString().padStart(2,'0');}
  function setStatus(kind,label){
    $.status.classList.remove('live','draft','saving');
    if (kind) $.status.classList.add(kind);
    $.statusLabel.textContent = label;
  }
  function renderPreview(){
    if (state.tab === 'code') {
      $.viewport.classList.add('code');
      $.viewport.innerHTML = '<pre id="codePre"></pre>';
      el('codePre').textContent = state.html || '';
    } else {
      if ($.viewport.classList.contains('code')) {
        $.viewport.classList.remove('code');
        $.viewport.innerHTML = '<iframe id="previewFrame" sandbox="allow-scripts allow-same-origin" referrerpolicy="no-referrer"></iframe>';
        $.iframe = el('previewFrame');
      }
      const iframe = $.viewport.querySelector('iframe');
      if (iframe) iframe.srcdoc = state.html || '<!doctype html><html><body style="font-family:DM Sans;background:#0a0a09;color:#5b574f;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;font-size:14px;letter-spacing:.04em">No portal yet. Describe one in the chat →</body></html>';
    }
  }
  function setHtml(html, opts={}){
    state.html = html;
    if (opts.persisted) state.publishedHtml = html;
    state.dirty = state.html !== state.publishedHtml;
    renderPreview();
    $.saveDraft.disabled = !state.dirty || state.busy;
    $.publishBtn.disabled = !state.html || state.busy;
    if (!opts.silent) {
      try { localStorage.setItem(DRAFT_KEY, state.html); } catch(_){}
    }
    if (state.dirty) setStatus('draft','Unsaved changes');
    else if (state.org?.is_published) setStatus('live','Live');
    else setStatus('draft','Draft');
  }
  function addMsg(role, content, extra={}){
    state.history.push({role, content, time: Date.now(), ...extra});
    persistHistory();
    renderMessages();
    $.chatLog.scrollTop = $.chatLog.scrollHeight;
  }
  function persistHistory(){
    try {
      const slim = state.history.slice(-20).map(m => ({role:m.role,content:m.content.slice(0,2000),time:m.time,kind:m.kind}));
      localStorage.setItem(HISTORY_KEY, JSON.stringify(slim));
    } catch(_){}
  }
  function renderMessages(){
    $.chatLog.innerHTML = '';
    state.history.forEach(m => {
      const wrap = document.createElement('div');
      wrap.className = 'msg ' + (m.kind || m.role);
      const meta = document.createElement('div'); meta.className='msg-meta';
      meta.textContent = m.role === 'user' ? 'You' : (m.role === 'assistant' ? 'AI' : (m.kind === 'err' ? 'Error' : 'System'));
      const body = document.createElement('div'); body.className='msg-body';
      body.textContent = m.content;
      wrap.appendChild(meta); wrap.appendChild(body);
      if (m.time) {
        const t = document.createElement('div'); t.className='msg-time';
        t.textContent = new Date(m.time).toLocaleTimeString([], {hour:'2-digit',minute:'2-digit'});
        wrap.appendChild(t);
      }
      $.chatLog.appendChild(wrap);
    });
  }
  function showTyping(on){
    const existing = el('typingRow');
    if (on && !existing) {
      const wrap = document.createElement('div');
      wrap.id = 'typingRow'; wrap.className = 'msg ai';
      wrap.innerHTML = '<div class="msg-meta">AI</div><div class="msg-body"><span class="typing"><span></span><span></span><span></span></span></div>';
      $.chatLog.appendChild(wrap);
      $.chatLog.scrollTop = $.chatLog.scrollHeight;
    } else if (!on && existing) {
      existing.remove();
    }
  }

  // ── Auth gate ──────────────────────────────────────────
  async function bootstrap(){
    const { data: { session } } = await sb.auth.getSession();
    if (!session?.user) return showGate('Sign in to <em>edit</em>', 'Portal editing is for clinic owners. Sign in to continue.', 'Sign in', '/patient-portal?role=owner');

    state.user = session.user;
    const [profileRes, orgRes] = await Promise.all([
      sb.from('profiles').select('role,name,account_code').eq('id', session.user.id).maybeSingle(),
      sb.from('organizations').select('*').eq('owner_id', session.user.id).maybeSingle(),
    ]);
    const profile = profileRes.data;
    if (!profile || (profile.role !== 'clinic_owner' && profile.role !== 'admin')) {
      return showGate('Not <em>authorized</em>', 'This page is only for clinic owners. If you should have owner access, please contact support.', 'Open dashboard', '/dashboard');
    }
    if (!orgRes.data) {
      return showGate('Finish <em>onboarding</em>', "You haven't set up your clinic yet. Complete onboarding to start editing your portal.", 'Start onboarding', '/onboarding');
    }
    state.org = orgRes.data;

    // Load services + products for prompt grounding.
    const [svc, prd] = await Promise.all([
      sb.from('clinic_services').select('id,name,description,category,duration_min,price_cents').eq('org_id', state.org.id).limit(50),
      sb.from('products').select('id,name,description,category,price,image_url').eq('org_id', state.org.id).limit(50),
    ]);
    state.services = svc.data || [];
    state.products = prd.data || [];

    revealApp();
    seedFromOrg();
    bindUI();
  }
  function showGate(titleHtml, msgHtml, cta, ctaHref){
    $.gate.hidden = false;
    $.gateTitle.innerHTML = titleHtml;
    $.gateMsg.innerHTML = msgHtml;
    $.gateCta.textContent = cta;
    $.gateCta.href = ctaHref;
  }
  function revealApp(){
    $.gate.hidden = true;
    $.topbar.hidden = false;
    $.app.hidden = false;
  }

  // ── Seed initial state ─────────────────────────────────
  function seedFromOrg(){
    $.crumb.textContent = state.org.name || 'Untitled clinic';
    state.publishedHtml = state.org.portal_html || '';

    // Restore a local draft if it's different from the persisted version.
    let draft = '';
    try { draft = localStorage.getItem(DRAFT_KEY) || ''; } catch(_){}
    const initialHtml = (draft && draft !== state.publishedHtml) ? draft : state.publishedHtml;

    // Restore chat history.
    try {
      const raw = localStorage.getItem(HISTORY_KEY);
      if (raw) state.history = JSON.parse(raw).slice(-20);
    } catch(_){}
    if (!state.history.length) {
      state.history.push({
        role:'system', kind:'system', time: Date.now(),
        content: state.publishedHtml
          ? `Editing the live portal for ${state.org.name}. Make any changes and publish when ready.`
          : `Welcome. Describe what you want your portal to look like and I'll build it. Try a chip below to get started.`,
      });
    }
    renderMessages();

    setHtml(initialHtml, {persisted: !draft || draft === state.publishedHtml, silent: true});
    if (state.org.slug && state.org.is_published) {
      $.viewLive.disabled = false;
      $.viewLive.onclick = () => window.open('/c/' + state.org.slug, '_blank');
    }
    $.slugInput.value = state.org.slug || '';
    updateLiveUrlPreview();

    // Initial status
    if (state.dirty) setStatus('draft','Unsaved changes');
    else if (state.org.is_published) setStatus('live','Live');
    else setStatus('draft','Draft');

    renderChips();
    $.chatInput.focus();
  }

  function renderChips(){
    const hasPortal = !!state.html;
    const chips = hasPortal ? [
      'Make the hero feel more editorial, bigger serif, more whitespace',
      'Add a doctor bios section under the hero with placeholder names',
      'Switch to a dark mode palette with cream accents',
      'Add a testimonials marquee strip',
      'Add a sticky CTA bar at the bottom that says Book a visit',
    ] : [
      'Generate a premium portal for my clinic',
      'Build a portal with a hero, services grid, and contact section',
      'Generate something editorial and minimal, lots of whitespace',
      'Build a dark, moody portal with a full-bleed hero image',
    ];
    $.chipRow.innerHTML = '';
    chips.forEach(c => {
      const b = document.createElement('button');
      b.className='chip'; b.textContent = c;
      b.onclick = () => { $.chatInput.value = c; $.chatInput.focus(); autoSize(); $.chatSend.disabled = false; };
      $.chipRow.appendChild(b);
    });
  }

  // ── UI bindings ────────────────────────────────────────
  function bindUI(){
    // Preview tabs
    document.querySelectorAll('.preview-tab').forEach(t => {
      t.onclick = () => {
        document.querySelectorAll('.preview-tab').forEach(x => x.classList.remove('active'));
        t.classList.add('active');
        state.tab = t.dataset.tab;
        renderPreview();
      };
    });
    // Viewport switches
    document.querySelectorAll('.preview-actions button').forEach(b => {
      b.onclick = () => {
        document.querySelectorAll('.preview-actions button').forEach(x => x.classList.remove('active'));
        b.classList.add('active');
        const vp = b.dataset.vp;
        state.viewport = vp;
        $.viewport.classList.remove('mobile','tablet');
        if (vp === 'mobile') $.viewport.classList.add('mobile');
        else if (vp === 'tablet') $.viewport.classList.add('tablet');
      };
    });
    // Chat input
    $.chatInput.addEventListener('input', () => { $.chatSend.disabled = state.busy || !$.chatInput.value.trim(); autoSize(); });
    $.chatInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); sendInstruction(); }
    });
    $.chatSend.onclick = sendInstruction;

    // Save / publish
    $.saveDraft.onclick = () => save({publish:false});
    $.publishBtn.onclick = () => openPublishModal();
    $.publishCancel.onclick = () => $.publishModal.hidden = true;
    $.publishConfirm.onclick = () => save({publish:true});
    $.slugInput.addEventListener('input', updateLiveUrlPreview);

    // Auth state — sign out elsewhere should kick us back to gate.
    sb.auth.onAuthStateChange((event, session) => {
      if (event === 'SIGNED_OUT') location.reload();
    });
  }
  function autoSize(){
    $.chatInput.style.height = 'auto';
    $.chatInput.style.height = Math.min(200, $.chatInput.scrollHeight) + 'px';
  }
  function updateLiveUrlPreview(){
    const s = ($.slugInput.value || state.org?.slug || '').toLowerCase().replace(/[^a-z0-9-]/g,'').slice(0,32);
    $.liveUrlPreview.textContent = `acuros.ca/c/${s || '(slug)'}`;
  }
  function openPublishModal(){
    if (!state.html) return;
    $.slugInput.value = state.org.slug || '';
    updateLiveUrlPreview();
    $.publishModal.hidden = false;
    $.slugInput.focus();
  }

  // ── AI call ────────────────────────────────────────────
  async function sendInstruction(){
    const text = $.chatInput.value.trim();
    if (!text || state.busy) return;
    $.chatInput.value = ''; autoSize();
    $.chatSend.disabled = true;
    addMsg('user', text);
    state.busy = true;
    setStatus('saving','AI thinking');
    showTyping(true);
    $.fullloadLabel.textContent = state.html ? 'Updating portal…' : 'Generating portal…';
    if (!state.html) $.fullload.hidden = false;

    try {
      const { data: { session } } = await sb.auth.getSession();
      const token = session?.access_token;
      if (!token) throw new Error('Session expired. Please sign in again.');

      const history = state.history
        .filter(m => m.role === 'user' || m.role === 'assistant')
        .slice(-10, -1)
        .map(m => ({role: m.role, content: m.content}));

      const resp = await fetch('/api/portal-edit', {
        method:'POST',
        headers: {'Content-Type':'application/json','Authorization':'Bearer '+token},
        body: JSON.stringify({
          instruction: text,
          currentHtml: state.html || null,
          history,
          org: { services: state.services, products: state.products },
        }),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok) throw new Error(data?.error || `Request failed (${resp.status})`);
      if (!data.html) throw new Error('AI returned no HTML.');

      showTyping(false);
      addMsg('assistant', data.message || 'Updated.');
      setHtml(data.html, {persisted: false});
      if (data.modelUsed) $.modelInfo.textContent = 'Claude · ' + data.modelUsed.replace(/-/g,' ');
    } catch (err) {
      showTyping(false);
      addMsg('assistant', err.message || 'Something went wrong.', {kind:'err'});
      setStatus('draft','Last edit failed');
    } finally {
      state.busy = false;
      $.fullload.hidden = true;
      $.chatSend.disabled = !$.chatInput.value.trim();
      $.saveDraft.disabled = !state.dirty;
      $.publishBtn.disabled = !state.html;
    }
  }

  // ── Save / publish ─────────────────────────────────────
  async function save({publish}){
    if (!state.html) return;
    state.busy = true;
    setStatus('saving', publish ? 'Publishing…' : 'Saving…');
    $.saveDraft.disabled = true; $.publishBtn.disabled = true;

    try {
      const { data: { session } } = await sb.auth.getSession();
      const token = session?.access_token;
      if (!token) throw new Error('Session expired. Please sign in again.');

      const body = { html: state.html, publish: !!publish };
      if (publish && $.slugInput.value) body.slug = $.slugInput.value.toLowerCase().trim();

      const resp = await fetch('/api/portal-save', {
        method:'POST',
        headers: {'Content-Type':'application/json','Authorization':'Bearer '+token},
        body: JSON.stringify(body),
      });
      const data = await resp.json().catch(() => ({}));
      if (!resp.ok) throw new Error(data?.error || `Save failed (${resp.status})`);

      state.publishedHtml = state.html;
      state.dirty = false;
      if (publish) {
        state.org.is_published = true;
        if (data.slug) state.org.slug = data.slug;
        $.publishModal.hidden = true;
        $.viewLive.disabled = false;
        $.viewLive.onclick = () => window.open('/c/' + state.org.slug, '_blank');
        addMsg('system','Published to acuros.ca/c/' + state.org.slug, {kind:'system'});
        setStatus('live','Live');
      } else {
        addMsg('system','Draft saved.', {kind:'system'});
        setStatus(state.org.is_published ? 'live' : 'draft', state.org.is_published ? 'Live' : 'Draft saved');
      }
      try { localStorage.removeItem(DRAFT_KEY); } catch(_){}
    } catch (err) {
      addMsg('system', err.message || 'Save failed.', {kind:'err'});
      setStatus('draft', publish ? 'Publish failed' : 'Save failed');
    } finally {
      state.busy = false;
      $.saveDraft.disabled = !state.dirty;
      $.publishBtn.disabled = !state.html;
    }
  }

  // Warn on tab close with unsaved changes
  window.addEventListener('beforeunload', (e) => {
    if (state.dirty && state.html) { e.preventDefault(); e.returnValue = ''; }
  });

  bootstrap().catch(err => {
    console.error(err);
    showGate('Editor <em>error</em>', err?.message || 'Something went wrong loading the editor.', 'Reload', location.pathname);
  });
})();
</script>
</body>
</html>
