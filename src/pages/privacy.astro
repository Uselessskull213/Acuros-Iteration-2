  <script is:inline>tailwind.config={darkMode:'class',theme:{extend:{fontFamily:{display:['Cormorant Garamond','Georgia','serif'],sans:['DM Sans','sans-serif']}}}}</script>
  <style is:inline>
    :root{--bg:#f0ebe1;--bg2:#f8f4ec;--bg3:#e6e0d4;--border:#d4cdb8;--text:#1c1a14;--sub:#5c5346;--mute:#a09480;--ac:#c9922a;--nav:rgba(240,235,225,.97)}
    html.dark{--bg:#0c0c0a;--bg2:#111110;--bg3:#161614;--border:#1e1e1b;--text:#f0ede8;--sub:#8c8880;--mute:#4e4c48;--ac:#4990d4;--nav:rgba(12,12,10,.97)}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);transition:background .3s,color .3s;overflow-x:hidden}
    h1,h2,h3,h4{font-family:'Cormorant Garamond',serif;line-height:1.08;letter-spacing:-.015em}
    nav{position:fixed;top:0;left:0;right:0;z-index:200;background:var(--nav);backdrop-filter:blur(20px) saturate(180%);border-bottom:1px solid var(--border);transition:background .3s,border-color .3s}
    .nav-link{position:relative;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute);background:none;border:none;cursor:pointer;padding:0;font-family:inherit;transition:color .2s;text-decoration:none;display:inline-block}
    .nav-link::after{content:'';position:absolute;left:0;bottom:-2px;width:0;height:1px;background:var(--ac);transition:width .25s}
    .nav-link:hover::after,.nav-link.active::after{width:100%}
    .nav-link:hover,.nav-link.active{color:var(--text)}
    /* ── Buttons — premium, theme-aware, with shimmer sweep ── */
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:.5rem;
      padding:.78rem 1.875rem;font-size:.64rem;letter-spacing:.18em;text-transform:uppercase;
      font-weight:500;font-family:'DM Sans',sans-serif;cursor:pointer;border:1px solid transparent;
      text-decoration:none;position:relative;overflow:hidden;isolation:isolate;
      transition:background .32s cubic-bezier(.22,1,.36,1),color .32s,transform .32s,border-color .32s,box-shadow .32s;
      will-change:transform
    }
    .btn::before{
      content:'';position:absolute;inset:0;z-index:-1;
      background:linear-gradient(110deg,transparent 0%,transparent 38%,rgba(255,255,255,.18) 50%,transparent 62%,transparent 100%);
      transform:translateX(-110%);transition:transform .9s cubic-bezier(.22,1,.36,1);pointer-events:none
    }
    .btn:hover::before{transform:translateX(110%)}
    .btn:not([disabled]):active{transform:scale(.97);transition-duration:80ms}
    .btn-pill{border-radius:100px}
    .btn-solid{background:var(--text);color:var(--bg);border-color:var(--text)}
    .btn-solid:hover{background:var(--ac);color:#fff;border-color:var(--ac);box-shadow:0 10px 28px -10px rgba(73,144,212,.55)}
    .btn-outline{background:transparent;color:var(--text);border-color:var(--border)}
    .btn-outline:hover{border-color:var(--ac);color:var(--ac);background:rgba(201,146,42,.06)}
    html.dark .btn-outline:hover{background:rgba(73,144,212,.06)}
    html:not(.dark) .btn-solid{background:#1c1a14;color:#fff;border-color:#1c1a14}
    html:not(.dark) .btn-solid:hover{background:var(--ac);color:#fff;border-color:var(--ac)}
    .btn-ac{background:var(--ac);color:#fff;border-color:var(--ac)}
    .btn-ac:hover{filter:brightness(1.08);box-shadow:0 10px 28px -10px rgba(73,144,212,.5)}
    .mag{display:inline-flex;transition:transform .38s cubic-bezier(.22,1,.36,1)}
    .lbl{font-family:'DM Sans',sans-serif;font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--mute);font-weight:500}
    .hr{height:1px;background:var(--border)}
    .tlink{color:var(--ac);text-decoration:none;border-bottom:1px solid transparent;transition:border-color .2s}
    .tlink:hover{border-color:var(--ac)}
    .mesh{background-image:linear-gradient(var(--border) 1px,transparent 1px),linear-gradient(90deg,var(--border) 1px,transparent 1px);background-size:52px 52px}
    .legal h2{font-family:'Cormorant Garamond',serif;font-size:1.45rem;font-weight:400;margin:2.25rem 0 .6rem;color:var(--text)}
    .legal p,.legal li{font-size:.88rem;line-height:1.9;color:var(--sub)}
    .legal ul{padding-left:1.4rem;margin-top:.4rem}
    .legal li{margin-bottom:.35rem}
    .legal strong{color:var(--text);font-weight:500}
    @keyframes pgIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
    #mob-menu{display:none;position:fixed;inset:0;z-index:300;background:var(--bg);flex-direction:column;padding:2.5rem}
    #mob-menu.open{display:flex;animation:pgIn .3s ease}
    @media(max-width:900px){.hnm{display:none!important}#mob-btn{display:flex!important}#nav-cta{display:none!important}}
    /* ── Ambient star field ── */
    #star-canvas{position:fixed;inset:0;pointer-events:none;z-index:1;overflow:hidden}
    .star{position:absolute;width:2px;height:2px;border-radius:1px;background:var(--ac);opacity:0;transform:rotate(45deg) scale(.3);animation:starPulse var(--dur,5s) var(--del,0s) ease-in-out infinite}
    @keyframes starPulse{0%,100%{opacity:0;transform:rotate(45deg) scale(.2)}40%,60%{opacity:var(--peak,.18);transform:rotate(45deg) scale(1)}}
  
    /* ── Canonical NAV (uniform across site) ── */
    nav#main-nav{position:fixed;top:0;left:0;right:0;z-index:200;background:transparent;transition:background .45s cubic-bezier(.22,1,.36,1),border-color .45s,backdrop-filter .45s}
    nav#main-nav.scrolled,nav#main-nav.solid{background:var(--nav);backdrop-filter:blur(28px) saturate(180%);-webkit-backdrop-filter:blur(28px) saturate(180%);border-bottom:1px solid var(--border)}
    .nav-inner{height:72px;max-width:1440px;margin:0 auto;padding:0 3rem;display:flex;align-items:center;justify-content:space-between;transition:height .4s cubic-bezier(.22,1,.36,1)}
    nav#main-nav.scrolled .nav-inner,nav#main-nav.solid .nav-inner{height:60px}
    .nav-logo{display:flex;align-items:center;gap:.875rem;text-decoration:none}
    #nav-logo-img{width:32px;height:32px;object-fit:contain;display:block}
    .nav-logo-text{font-family:'Cormorant Garamond',serif;font-weight:300;font-size:.9rem;letter-spacing:.22em;color:var(--text);line-height:1}
    .nav-logo-sub{font-size:.42rem;letter-spacing:.42em;text-transform:uppercase;color:var(--mute);font-family:'DM Sans',sans-serif;font-weight:400}
    .nav-link{position:relative;font-size:.58rem;letter-spacing:.2em;text-transform:uppercase;color:var(--sub);background:none;border:none;cursor:pointer;padding:0;font-family:inherit;transition:color .22s;text-decoration:none;display:inline-block}
    .nav-link::after{content:'';position:absolute;left:0;bottom:-2px;width:0;height:1px;background:var(--ac);transition:width .3s cubic-bezier(.22,1,.36,1)}
    .nav-link:hover::after,.nav-link.active::after{width:100%}
    .nav-link:hover,.nav-link.active{color:var(--text)}
    @media(max-width:900px){.hnm{display:none!important}#mob-btn{display:flex!important}#nav-cta{display:none!important}.nav-inner{padding:0 1.5rem}}

  </style>
</head>
<body>

<!-- NAV -->
<nav id="main-nav" class="solid">
